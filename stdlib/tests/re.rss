use re;

fn assert_some_string(actual: Option<string>, expected: string) -> bool {
    actual.unwrap_or("") == expected
}

assert(re::match("^foo", "foobar"));
assert(re::match("^foo", "barfoo") == false);
assert(re::match("^foo", "foobar"));
assert(re::match("(?i)^foo$", "FoO"));
assert(re::match("(?is)^foo.bar$", "FoO\nbar"));
assert(re::match("(?m)^bar$", "foo\nbar\nbaz"));

let first = re::find("bar+", "foobarr");
assert(assert_some_string(first, "barr"));

let first_icase = re::find("(?i)^foo", "FoO bar");
assert(assert_some_string(first_icase, "FoO"));

let missing = re::find("z+", "foobarr");
let missing_is_none = match missing {
    Option::Some(_) => false,
    Option::None => true,
};
assert(missing_is_none);

let replaced = re::replace("(foo)+", "foofoo bar", "x");
assert(replaced == "x bar");

let replaced_icase = re::replace("(?i)foo", "FoO bar", "x");
assert(replaced_icase == "x bar");

let parts = re::split(" +", "a   b c");
assert(parts.length == 3);
assert(parts[0] == "a");
assert(parts[1] == "b");
assert(parts[2] == "c");

let parts_icase = re::split("(?i)x", "aXb");
assert(parts_icase.length == 2);
assert(parts_icase[0] == "a");
assert(parts_icase[1] == "b");

let groups = re::captures("([a-z]+)-([0-9]+)", "item-42");
assert(groups.length == 3);
assert(groups[0].unwrap_or("") == "item-42");
assert(groups[1].unwrap_or("") == "item");
assert(groups[2].unwrap_or("") == "42");

let groups_icase = re::captures("(?i)^(foo)-([0-9]+)$", "FoO-42");
assert(groups_icase.length == 3);
assert(groups_icase[1].unwrap_or("") == "FoO");
assert(groups_icase[2].unwrap_or("") == "42");

let no_groups = re::captures("(foo)", "bar");
assert(no_groups.length == 0);

let optional = re::captures("(a)?b", "b");
assert(optional.length == 2);
let unmatched_is_none = match optional[1] {
    Option::Some(_) => false,
    Option::None => true,
};
assert(unmatched_is_none);

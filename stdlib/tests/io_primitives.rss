use super::rss::strings as string;
use io;

assert(io::exists("stdlib/rss/strings.rss"));

// Runs a command, reads every byte it prints, and closes the handle, so a
// failure at any step reaches the caller instead of an empty string.
fn read_command_output(command: string) -> Result<string, string> {
    let handle = io::popen(command, "r")?;
    let output = io::read_all(handle)?;
    io::close(handle)?;
    Result::Ok(output)
}

let mut popen_ok = match read_command_output("echo rustscript_io_builtin") {
    Result::Ok(output) => string::contains(output, "rustscript_io_builtin"),
    Result::Err(message) => false,
};
assert(popen_ok);

use super::rss::collections::{contains, dedup, entries, get_or, has, index_of, merge, reverse, values};

// W02: `index_of` reports absence with `Option<int>`, so every assertion below
// distinguishes a found position from a miss instead of comparing against a -1
// sentinel.
fn index_of_int(values: [int], needle: int) -> Option<int> {
    index_of::<int>(values, needle)
}

fn index_position(values: [int], needle: int, fallback: int) -> int {
    match index_of_int(values, needle) {
        Option::Some(value) => value,
        Option::None => fallback,
    }
}

fn index_is_some(values: [int], needle: int) -> bool {
    match index_of_int(values, needle) {
        Option::Some(_) => true,
        Option::None => false,
    }
}

let mut appended = [1, 2] + [3, 4];
assert(appended.length == 4);
assert(appended.copy()[0] == 1);
assert(appended.copy()[3] == 4);

assert(index_is_some(appended, 1));
assert(index_position(appended, 1, -1) == 0);
assert(index_position(appended, 3, -1) == 2);
assert(index_position(appended, 4, -1) == 3);
assert(index_is_some(appended, 9) == false);
assert(index_position(appended, 9, 99) == 99);
assert(contains::<int>(appended, 1));
assert(contains::<int>(appended, 4));
assert(contains::<int>(appended, 9) == false);

let mut reversed = reverse::<int>(appended);
assert(reversed.length == 4);
assert(reversed[0] == 4);
assert(reversed[3] == 1);

let mut unique = dedup::<int>([1, 1, 2, 3, 2, 3]);
assert(unique.length == 3);
assert(unique[0] == 1);
assert(unique[1] == 2);
assert(unique[2] == 3);

let mut left = {x: 1, y: 2};
let mut right = {y: 20, z: 3};
let mut merged = merge::<int>(left, right);
assert(has::<string, int>(merged, "x"));
assert(has::<string, int>(merged, "z"));
assert(has::<string, int>(merged, "missing") == false);
assert(get_or::<string, int>(merged, "y", 0) == 20);
assert(get_or::<string, int>(merged, "missing", 9) == 9);

let mut sparse: map<int> = {keep: 1, drop: 2};
sparse = sparse.remove("drop");
assert(has::<string, int>(sparse, "keep"));
assert(has::<string, int>(sparse, "drop") == false);
sparse = sparse.remove("keep");
assert(has::<string, int>(sparse, "keep") == false);

let mut pruned: map<int> = {x: 1, y: 2};
pruned = pruned.remove("y");
let mut merged_without = merge::<int>(pruned, {z: 3});
assert(has::<string, int>(merged_without, "x"));
assert(has::<string, int>(merged_without, "y") == false);
assert(has::<string, int>(merged_without, "z"));
assert(get_or::<string, int>(merged_without, "y", 9) == 9);

let mut only_values = values::<int>(merged);
assert(only_values.length == 3);
assert(contains::<int>(only_values, 1));
assert(contains::<int>(only_values, 20));
assert(contains::<int>(only_values, 3));

let mut rows = entries::<string, int>(merged);
assert(rows.length == 3);
assert(rows[0].length == 2);

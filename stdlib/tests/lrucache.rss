use super::rss::lrucache::{capacity, clear, entries, get, has, is_empty, keys, len, new, newest, oldest, peek, put, remove, touch, values};

struct FeedItem {
    slug: string,
    score: int
}

let mut cache = new::<string, int>(2);
assert(capacity::<string, int>(cache) == 2);
assert(len::<string, int>(cache) == 0);
assert(is_empty::<string, int>(cache));

cache = put::<string, int>(cache, "a", 1);
cache = put::<string, int>(cache, "b", 2);

let mut initial_keys = keys::<string, int>(cache);
assert(initial_keys.length == 2);
assert(initial_keys[0] == "a");
assert(initial_keys[1] == "b");

// W01: `peek` reports presence with `Option<V>` and never promotes recency.
let peeked_value = match peek::<string, int>(cache, "a") {
    Option::Some(value) => value,
    Option::None => -1,
};
assert(peeked_value == 1);
let peeked_absent = match peek::<string, int>(cache, "missing") {
    Option::Some(_) => false,
    Option::None => true,
};
assert(peeked_absent);
let mut still_initial = keys::<string, int>(cache);
assert(still_initial[0] == "a");
assert(still_initial[1] == "b");

// `get` keeps the updated cache and the payload; the redundant `found` flag is
// gone, so absence is read from the `Option` alone.
let mut accessed = get::<string, int>(cache, "a");
let accessed_value = match accessed.value {
    Option::Some(value) => value,
    Option::None => -1,
};
assert(accessed_value == 1);
cache = accessed.cache;
let mut after_get = keys::<string, int>(cache);
assert(after_get[0] == "b");
assert(after_get[1] == "a");

// `oldest` / `newest` report one key/value row, so the pair can never
// disagree about presence.
let oldest_key = match oldest::<string, int>(cache) {
    Option::Some(row) => row.key,
    Option::None => "missing",
};
assert(oldest_key == "b");
let oldest_value = match oldest::<string, int>(cache) {
    Option::Some(row) => row.value,
    Option::None => -1,
};
assert(oldest_value == 2);

let newest_key = match newest::<string, int>(cache) {
    Option::Some(row) => row.key,
    Option::None => "missing",
};
assert(newest_key == "a");
let newest_value = match newest::<string, int>(cache) {
    Option::Some(row) => row.value,
    Option::None => -1,
};
assert(newest_value == 1);

cache = put::<string, int>(cache, "c", 3);
let mut after_evict = keys::<string, int>(cache);
assert(after_evict[0] == "a");
assert(after_evict[1] == "c");
assert(has::<string, int>(cache, "a"));
assert(has::<string, int>(cache, "b") == false);
assert(has::<string, int>(cache, "c"));

let mut cache_values = values::<string, int>(cache);
assert(cache_values.length == 2);
assert(cache_values[0] == 1);
assert(cache_values[1] == 3);

cache = put::<string, int>(cache, "a", 10);
let mut after_update = keys::<string, int>(cache);
assert(after_update[0] == "c");
assert(after_update[1] == "a");
let updated_value = match peek::<string, int>(cache, "a") {
    Option::Some(value) => value,
    Option::None => -1,
};
assert(updated_value == 10);

let mut missed = get::<string, int>(cache, "missing");
let missed_is_none = match missed.value {
    Option::Some(_) => false,
    Option::None => true,
};
assert(missed_is_none);
cache = missed.cache;
let mut after_miss = keys::<string, int>(cache);
assert(after_miss[0] == "c");
assert(after_miss[1] == "a");

cache = touch::<string, int>(cache, "c");
let mut after_touch = keys::<string, int>(cache);
assert(after_touch[0] == "a");
assert(after_touch[1] == "c");

let mut rows = entries::<string, int>(cache);
assert(rows.length == 2);
let first_row = rows[0].copy();
let second_row = rows[1].copy();
let first_key: string = first_row.key;
let first_value: int = first_row.value;
let second_key: string = second_row.key;
let second_value: int = second_row.value;
assert(first_key == "a");
assert(first_value == 10);
assert(second_key == "c");
assert(second_value == 3);

cache = remove::<string, int>(cache, "a");
assert(len::<string, int>(cache) == 1);
let mut after_remove = keys::<string, int>(cache);
assert(after_remove[0] == "c");

cache = clear::<string, int>(cache);
assert(capacity::<string, int>(cache) == 2);
assert(len::<string, int>(cache) == 0);
assert(is_empty::<string, int>(cache));
let cleared_oldest = match oldest::<string, int>(cache) {
    Option::Some(_) => false,
    Option::None => true,
};
assert(cleared_oldest);
let cleared_newest = match newest::<string, int>(cache) {
    Option::Some(_) => false,
    Option::None => true,
};
assert(cleared_newest);

let mut disabled = new::<string, int>(0);
disabled = put::<string, int>(disabled, "x", 1);
assert(capacity::<string, int>(disabled) == 0);
assert(len::<string, int>(disabled) == 0);
assert(has::<string, int>(disabled, "x") == false);

let mut feed_cache = new::<int, FeedItem>(2);
feed_cache = put::<int, FeedItem>(feed_cache, 7, {slug: "alpha", score: 10});
feed_cache = put::<int, FeedItem>(feed_cache, 8, {slug: "beta", score: 20});

let cached_feed_value = match peek::<int, FeedItem>(feed_cache, 7) {
    Option::Some(value) => value.copy(),
    Option::None => {slug: "", score: 0},
};
assert(cached_feed_value.slug == "alpha");
assert(cached_feed_value.score == 10);

let mut accessed_feed = get::<int, FeedItem>(feed_cache, 7);
let accessed_feed_value = match accessed_feed.value {
    Option::Some(value) => value.copy(),
    Option::None => {slug: "", score: 0},
};
assert(accessed_feed_value.slug == "alpha");
feed_cache = accessed_feed.cache;

let mut feed_order = keys::<int, FeedItem>(feed_cache);
assert(feed_order[0] == 8);
assert(feed_order[1] == 7);

let mut feed_rows = entries::<int, FeedItem>(feed_cache);
let first_feed_row = feed_rows[0].copy();
let second_feed_row = feed_rows[1].copy();
assert(first_feed_row.key == 8);
assert(first_feed_row.value.slug == "beta");
assert(second_feed_row.key == 7);
assert(second_feed_row.value.score == 10);

let feed_oldest_key = match oldest::<int, FeedItem>(feed_cache) {
    Option::Some(row) => row.key,
    Option::None => -1,
};
assert(feed_oldest_key == 8);
let feed_oldest_value = match oldest::<int, FeedItem>(feed_cache) {
    Option::Some(row) => row.value.copy(),
    Option::None => {slug: "", score: 0},
};
assert(feed_oldest_value.slug == "beta");

let feed_newest_key = match newest::<int, FeedItem>(feed_cache) {
    Option::Some(row) => row.key,
    Option::None => -1,
};
assert(feed_newest_key == 7);
let feed_newest_value = match newest::<int, FeedItem>(feed_cache) {
    Option::Some(row) => row.value.copy(),
    Option::None => {slug: "", score: 0},
};
assert(feed_newest_value.score == 10);

// A false key with an empty-string payload is a real hit: `Option::Some(false)`
// and `Option::Some("")` are distinct from `Option::None`.
let mut flag_cache = new::<bool, string>(2);
flag_cache = put::<bool, string>(flag_cache, false, "");
let empty_payload_value = match peek::<bool, string>(flag_cache, false) {
    Option::Some(value) => value,
    Option::None => "missing",
};
assert(empty_payload_value == "");
let false_key_absent = match peek::<bool, string>(flag_cache, true) {
    Option::Some(_) => false,
    Option::None => true,
};
assert(false_key_absent);
let empty_payload_row = match oldest::<bool, string>(flag_cache) {
    Option::Some(row) => row.value,
    Option::None => "missing",
};
assert(empty_payload_row == "");

// A cached zero payload is a hit as well: presence comes from the `Option`
// variant, never from the payload's truthiness.
let mut zero_cache = new::<string, int>(1);
zero_cache = put::<string, int>(zero_cache, "zero", 0);
let zero_value = match peek::<string, int>(zero_cache, "zero") {
    Option::Some(value) => value,
    Option::None => 99,
};
assert(zero_value == 0);
let zero_absent = match peek::<string, int>(zero_cache, "missing") {
    Option::Some(_) => false,
    Option::None => true,
};
assert(zero_absent);
let zero_get = get::<string, int>(zero_cache, "zero");
let zero_get_value = match zero_get.value {
    Option::Some(value) => value,
    Option::None => 99,
};
assert(zero_get_value == 0);
zero_cache = zero_get.cache;

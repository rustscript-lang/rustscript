// I/O wrappers implemented in pure RustScript.
//
// Every wrapper reports the recoverable IO failure of the host `io` module to
// its caller. A close or flush failure is part of that contract: it is
// propagated instead of being swallowed, because a silently dropped buffer is
// data loss the caller cannot observe.
use io;

// Reads an entire file into a string.
pub fn read_text(path: string) -> Result<string, string> {
    let handle = io::open(path, "r")?;
    let text = io::read_all(handle)?;
    io::close(handle)?;
    Result::Ok(text)
}

// Writes text to a file, replacing any existing contents.
pub fn write_text(path: string, text: string) -> Result<int, string> {
    let handle = io::open(path, "w")?;
    let written = io::write(handle, text)?;
    io::flush(handle)?;
    io::close(handle)?;
    Result::Ok(written)
}

// Appends text to the end of a file.
pub fn append_text(path: string, text: string) -> Result<int, string> {
    let handle = io::open(path, "a")?;
    let written = io::write(handle, text)?;
    io::flush(handle)?;
    io::close(handle)?;
    Result::Ok(written)
}

// Reads a file and splits it into newline-delimited lines.
pub fn read_lines(path: string) -> Result<[string], string> {
    let text = read_text(path)?;
    let mut lines: [string] = [];
    let text_len =(&text).length;
    let mut start = 0;
    for index in 0..text_len {
        if (&text)[index:(index + 1)] == "\n" {
            lines[lines.length] =(&text)[start:index];
            start = index + 1;
        }
    }
    if start < text_len {
        lines[lines.length] =(&text)[start:text_len];
    }
    Result::Ok(lines)
}
